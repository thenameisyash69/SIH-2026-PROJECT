# Copy to .env and fill in for production / real data.
# The backend runs with NO keys set, using a local SQLite file + demo seed data.
DATABASE_URL=sqlite:///./sih.db
ANTHROPIC_API_KEY=

FIRMS_ENABLED=true
FIRMS_MAP_KEY=
FIRMS_AREA=68,6,97,37
FIRMS_SOURCES=VIIRS_NOAA21_NRT,VIIRS_NOAA20_NRT
FIRMS_SYNC_INTERVAL_MINUTES=15

CORS_ORIGINS=http://localhost:5173
